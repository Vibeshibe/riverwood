{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "riverwood",
  "compatibility_date": "2026-09-17",
  "main": "./worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/.well-known/webfinger",
      "/.well-known/host-meta",
      "/.well-known/nodeinfo"
    ]
  }
}
